@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-form-wrap">
        <div class="login-form">

            <p class="eyebrow">ORDERSYNC</p>

            <h2>Recuperar contraseña</h2>

            <p class="muted">
                Ingresa tu correo electrónico y te enviaremos un código
                para restablecer tu contraseña.
            </p>

            @if (!ViewData.ModelState.IsValid)
            {
                @Html.ValidationSummary(
                    false,
                    "",
                    new { @class = "alert alert-danger" })
            }

            <form action="@Url.Action("ForgotPassword", "Auth")"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="email">Correo electrónico</label>

                    <input type="email"
                           id="email"
                           name="email"
                           value="@ViewBag.Email"
                           class="form-control"
                           placeholder="correo@ejemplo.com"
                           autocomplete="email"
                           required />
                </div>

                <button type="submit" class="btn-primary">
                    Enviar código
                </button>

            </form>

            <p class="login-note">
                <a href="@Url.Action("Login", "Auth")">
                    Volver al inicio de sesión
                </a>
            </p>

        </div>
    </div>
</div>
