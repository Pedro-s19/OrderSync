@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-form-wrap">
        <div class="login-form">

            <p class="eyebrow">ORDERSYNC</p>

            <h2>Nueva contraseña</h2>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success">
                    @ViewBag.SuccessMessage
                </div>

                <p class="login-note">
                    <a asp-controller="Auth" asp-action="Login">
                        Ir al inicio de sesión
                    </a>
                </p>
            }
            else
            {
                <p class="muted">
                    Ingresa el código que recibiste en tu correo
                    y establece una nueva contraseña.
                </p>

                @if (ViewBag.RecoveryMessage != null)
                {
                    <div class="alert alert-success">
                        @ViewBag.RecoveryMessage
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(
                        false,
                        "",
                        new { @class = "alert alert-danger" })
                }

                <form asp-controller="Auth"
                      asp-action="ResetPassword"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="email">Correo electrónico</label>

                        <input type="email"
                               id="email"
                               name="email"
                               value="@ViewBag.Email"
                               class="form-control"
                               placeholder="correo@ejemplo.com"
                               autocomplete="email"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="code">Código de recuperación</label>

                        <input type="text"
                               id="code"
                               name="code"
                               value="@ViewBag.Code"
                               class="form-control"
                               placeholder="Código de 6 dígitos"
                               maxlength="6"
                               minlength="6"
                               pattern="[0-9]{6}"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="newPassword">Nueva contraseña</label>

                        <input type="password"
                               id="newPassword"
                               name="newPassword"
                               class="form-control"
                               placeholder="Nueva contraseña"
                               autocomplete="new-password"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword">
                            Confirmar contraseña
                        </label>

                        <input type="password"
                               id="confirmPassword"
                               name="confirmPassword"
                               class="form-control"
                               placeholder="Repite la contraseña"
                               autocomplete="new-password"
                               required />
                    </div>

                    <button type="submit" class="btn-primary">
                        Cambiar contraseña
                    </button>
                </form>

                <p class="login-note">
                    <a asp-controller="Auth"
                       asp-action="ForgotPassword">
                        Solicitar otro código
                    </a>
                </p>

                <p class="login-note">
                    <a asp-controller="Auth" asp-action="Login">
                        Volver al inicio de sesión
                    </a>
                </p>
            }

        </div>
    </div>
</div>
