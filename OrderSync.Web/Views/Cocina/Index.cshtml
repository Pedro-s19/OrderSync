@model List<OrderSync.Web.Services.OrderDetailDto>
@{ ViewData["Title"] = "Cocina"; }
<div class="page-heading"><div><span class="eyebrow purple">ÁREA DE PRODUCCIÓN</span><h1>Pantalla de cocina</h1><p class="muted">Pedidos confirmados por caja que están pendientes de preparación o finalización.</p></div><a class="btn-secondary" asp-action="Index">↻ Actualizar</a></div>
<div class="metric-grid"><article class="metric-card"><div class="metric-top"><span>Pedidos en cola</span><span class="metric-icon gold">♨</span></div><strong>@Model.Count</strong><small>Confirmados o en cocina</small></article><article class="metric-card"><div class="metric-top"><span>Unidades por preparar</span><span class="metric-icon purple-bg">▤</span></div><strong>@Model.Sum(x => x.Lineas.Sum(l => l.Cantidad))</strong><small>Total de productos en cola</small></article></div>
@if (!Model.Any()) { <div class="panel empty-kitchen"><div class="panel-symbol">🍔</div><h3>No hay pedidos pendientes</h3><p class="muted">Cuando Caja cree y confirme un pedido, aparecerá aquí automáticamente.</p></div> }
<div class="kitchen-grid">
@foreach (var order in Model.OrderBy(x => x.FechaCreacion)) { <article class="panel kitchen-card"><div class="kitchen-card-head"><div><span class="eyebrow purple">PEDIDO #@order.PedidoId</span><h3>@order.Canal @if (!string.IsNullOrWhiteSpace(order.Mesa)) { <small>· Mesa @order.Mesa</small> }</h3></div><span class="state-pill">@order.Estado</span></div><p class="muted">Recibido: @order.FechaCreacion.ToString("HH:mm · dd/MM/yyyy")</p><div class="kitchen-items">@foreach (var line in order.Lineas) { <div class="kitchen-item"><strong>@line.Cantidad ×</strong><span>@line.Producto</span></div> }</div><div class="kitchen-card-foot"><strong>@order.Total.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</strong><form asp-action="MarcarListo" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@order.PedidoId"/><button type="submit" class="btn-primary">Marcar como listo ✓</button></form></div></article> }
</div>
<div class="notice">Al marcar un pedido como listo, el estado se actualiza en la base de datos a través de <code>POST /api/pedidos/{id}/listo</code>.</div>
