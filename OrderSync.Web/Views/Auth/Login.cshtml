@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="login-shell">

    <!-- Panel visual de OrderSync -->
    <section class="login-visual">

        <div class="login-brand">
            <span class="brand-mark">O</span>
            <span>Order<span class="brand-accent">Sync</span></span>
        </div>

        <div class="login-message">
            <span class="eyebrow">TODO TU RESTAURANTE, EN UN SOLO LUGAR</span>

            <h1>
                El sabor de un negocio
                <i>bien organizado.</i>
            </h1>

            <p>
                Controla pedidos, inventario y cada detalle
                de tu operación desde una sola plataforma.
            </p>

            <div class="food-graphic">
                🍔 <span>🍟</span> 🥤
            </div>
        </div>

        <small class="login-copy">
            ORDER MANAGEMENT · INVENTORY · SALES
        </small>

    </section>

    <!-- Formulario de inicio de sesión -->
    <section class="login-form-wrap">

        <div class="login-form">

            <span class="eyebrow purple">BIENVENIDO DE NUEVO</span>

            <h2>Iniciar sesión</h2>

            <p class="muted">
                Ingresa tus credenciales para continuar.
            </p>

            <form asp-controller="Auth"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Mensajes de validación y errores de autenticación -->
                <div asp-validation-summary="ModelOnly"
                     class="validation"
                     role="alert"
                     aria-live="polite">
                </div>

                <!-- Correo electrónico -->
                <label for="email">Correo electrónico</label>

                <input id="email"
                       name="email"
                       type="email"
                       value="@ViewBag.Email"
                       placeholder="usuario@ordersync.local"
                       required
                       autocomplete="username"
                       maxlength="150" />

                <!-- Contraseña -->
                <label for="password">Contraseña</label>

                <input id="password"
                       name="password"
                       type="password"
                       placeholder="Ingresa tu contraseña"
                       required
                       autocomplete="current-password" />

                <!-- Selección de rol -->
                <label for="rol">Rol de acceso</label>

                <select id="rol" name="rol" required>

                    <option value="">Selecciona tu rol</option>

                    <option value="Cajero"
                            selected="@(ViewBag.Rol?.ToString() == "Cajero")">
                        Cajero
                    </option>

                    <option value="Cocina"
                            selected="@(ViewBag.Rol?.ToString() == "Cocina")">
                        Cocina
                    </option>

                    <option value="Supervisor"
                            selected="@(ViewBag.Rol?.ToString() == "Supervisor")">
                        Supervisor
                    </option>

                    <option value="Gerencia"
                            selected="@(ViewBag.Rol?.ToString() == "Gerencia")">
                        Gerencia
                    </option>

                    <option value="Administrador del Sistema"
                            selected="@(ViewBag.Rol?.ToString() == "Administrador del Sistema")">
                        Administrador del Sistema
                    </option>

                </select>

                <!-- Botón de acceso -->
                <button class="btn-primary btn-login" type="submit">
                    Ingresar al sistema
                    <span>→</span>
                </button>

            </form>

            <!-- Recuperación de contraseña -->
            <div class="login-note">
                <a asp-controller="Auth" asp-action="ForgotPassword">
                    ¿Olvidaste tu contraseña?
                </a>
            </div>

            <div class="login-note">
                <span>▣</span>
                Acceso protegido mediante autenticación JWT
            </div>

        </div>

    </section>

</div>
