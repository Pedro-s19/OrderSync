@model List<StockAlertDto>
@{
    ViewData["Title"] = "Inventario";
    var currentRole = Context.Session.GetString("Rol") ?? string.Empty;
    var canManageInventory = currentRole is "Supervisor" or "Administrador del Sistema";
}

<div class="page-heading">
    <div>
        <span class="eyebrow purple">CONTROL DE EXISTENCIAS</span>
        <h1>Inventario</h1>
        <p class="muted">Alertas abiertas de ingredientes con nivel de stock crítico.</p>
    </div>

    <div class="heading-actions">
        <span class="count-pill warning-count">@Model.Count alertas</span>
        <a class="btn-primary"
           asp-controller="Gestion"
           asp-action="Index"
           asp-route-modulo="Ingredientes">
            Ingredientes
        </a>

        @if (canManageInventory)
        {
            <a class="btn-primary" asp-controller="Panel" asp-action="Movimiento">
                Mermas / ajustes
            </a>
        }
    </div>
</div>

<div class="panel table-panel">
    <div class="table-toolbar">
        <div>
            <h3>Alertas de inventario</h3>
            <p class="muted">Datos consultados desde <code>GET /api/inventario/alertas</code>.</p>
        </div>
    </div>

    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>ALERTA</th>
                    <th>INGREDIENTE</th>
                    <th>STOCK ACTUAL</th>
                    <th>STOCK MÍNIMO</th>
                    <th>ESTADO</th>
                    <th>ACCIÓN</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            No hay alertas abiertas o no hay datos disponibles.
                        </td>
                    </tr>
                }

                @foreach (var alert in Model)
                {
                    <tr>
                        <td class="id-cell">#@alert.AlertaId</td>
                        <td><strong>@alert.Ingrediente</strong></td>
                        <td class="critical-value">@alert.StockAlMomento</td>
                        <td>@alert.StockMinimo</td>
                        <td>
                            <span class="state-pill state-warning">@alert.Estado</span>
                        </td>
                        <td>
                            @if (alert.Estado == "ABIERTA" && canManageInventory)
                            {
                                <form asp-action="Atender" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@alert.AlertaId" />
                                    <button class="btn-small" type="submit">Atender</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="notice">
    El descuento automático de ingredientes se ejecuta en el backend al confirmar un pedido,
    de acuerdo con la receta asociada.
</div>
