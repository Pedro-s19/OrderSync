@{ ViewData["Title"] = "Mi resumen"; var role = ViewBag.Rol as string ?? ""; var kitchen = role == "Cocina"; var cashier = role == "Cajero"; }
<div class="welcome-row"><div><span class="eyebrow purple">PANEL DE @role.ToUpperInvariant()</span><h1>¡Hola, @ViewBag.Nombre! <span>✦</span></h1><p class="muted">@(kitchen ? "Aquí aparecen los pedidos que Caja ha confirmado." : cashier ? "Registra pedidos y envíalos a preparación." : "Consulta la operación del restaurante.")</p></div><div class="date-chip">◷ &nbsp; @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-CO"))</div></div>
<div class="content-grid"><article class="panel welcome-panel"><div class="panel-heading"><div><span class="eyebrow purple">ORDERSYNC ERP</span><h3>@(kitchen ? "Preparación de pedidos" : cashier ? "Punto de venta" : "Gestión del restaurante")</h3></div><span class="panel-symbol">🍔</span></div><p>@(kitchen ? "Consulta los pedidos pendientes, revisa sus productos y marca cada orden como lista cuando termine la preparación." : cashier ? "Crea pedidos con productos del menú, confirma la orden y envíala a cocina. El backend calcula los precios y descuenta inventario según las recetas." : "Los módulos disponibles se muestran de acuerdo con los permisos asignados a tu rol.")</p><div class="quick-links">
@if (kitchen) { <a asp-controller="Cocina" asp-action="Index"><span>♨</span><b>Abrir cocina</b><small>Ver pedidos pendientes</small></a> }
@if (cashier) { <a asp-controller="Pedidos" asp-action="Crear"><span>＋</span><b>Crear pedido</b><small>Registrar una nueva orden</small></a><a asp-controller="Pedidos" asp-action="Index"><span>▤</span><b>Ver pedidos</b><small>Confirmar órdenes</small></a> }
@if (!kitchen && !cashier) { <a asp-controller="Pedidos" asp-action="Index"><span>▤</span><b>Consultar pedidos</b><small>Seguimiento de órdenes</small></a><a asp-controller="Productos" asp-action="Index"><span>☷</span><b>Productos</b><small>Consultar menú</small></a> }
</div></article><article class="panel side-info"><span class="eyebrow purple">FLUJO DE DEMOSTRACIÓN</span><h3>Operación conectada</h3><div class="module-line"><span class="status-dot"></span> 1. Crear pedido <b>API</b></div><div class="module-line"><span class="status-dot"></span> 2. Confirmar / descontar stock <b>API</b></div><div class="module-line"><span class="status-dot"></span> 3. Cocina marca listo <b>API</b></div></article></div>
<div class="notice"><b>Datos reales:</b> pedidos, productos y cambios de estado se consultan y registran mediante OrderSync API en la base de datos configurada en el backend.</div>
