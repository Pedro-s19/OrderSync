@using System.Text.Json
@model List<JsonElement>
@{
    ViewData["Title"] = "Programación de turnos";
    var empleados = ViewBag.Empleados as List<JsonElement> ?? new List<JsonElement>();
    var puedeGestionar = ViewBag.PuedeGestionar is bool value && value;
}

<div class="page-heading">
    <div>
        <span class="eyebrow">RECURSOS HUMANOS</span>
        <h1>Programación de turnos</h1>
        <p>Organiza los horarios del personal y consulta los turnos programados.</p>
    </div>
</div>

@if (puedeGestionar)
{
    <div class="panel form-panel">
        <h2>Programar nuevo turno</h2>
        <p>Selecciona un empleado y define la fecha y hora de inicio y finalización.</p>

        <form asp-action="ProgramarTurno" method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="form-field">
                    <label for="empleadoId">Empleado</label>
                    <select id="empleadoId" name="empleadoId" required>
                        <option value="">Selecciona un empleado</option>
                        @foreach (var empleado in empleados)
                        {
                            if (empleado.TryGetProperty("activo", out var activo) && activo.ValueKind == JsonValueKind.True)
                            {
                                <option value="@empleado.GetProperty("empleadoId").GetInt32()">
                                    @empleado.GetProperty("nombre").GetString()
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="inicio">Inicio</label>
                    <input id="inicio" name="inicio" type="datetime-local" required />
                </div>
                <div class="form-field">
                    <label for="fin">Finalización</label>
                    <input id="fin" name="fin" type="datetime-local" required />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Programar turno</button>
            </div>
        </form>
    </div>
}

<div class="panel">
    <div class="panel-heading">
        <div>
            <h2>Turnos registrados</h2>
            <p>Consulta los horarios dentro del periodo seleccionado.</p>
        </div>
    </div>

    <form asp-action="Turnos" method="get" class="form-grid">
        <div class="form-field">
            <label for="desde">Desde</label>
            <input id="desde" name="desde" type="date" value="@ViewBag.Desde" required />
        </div>
        <div class="form-field">
            <label for="hasta">Hasta</label>
            <input id="hasta" name="hasta" type="date" value="@ViewBag.Hasta" required />
        </div>
        <div class="form-field" style="align-self:end">
            <button class="btn btn-secondary" type="submit">Consultar</button>
        </div>
    </form>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Empleado</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Estado</th>
                    @if (puedeGestionar)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="@(puedeGestionar ? 5 : 4)">No hay turnos registrados en este periodo.</td>
                    </tr>
                }
                @foreach (var turno in Model)
                {
                    var turnoId = turno.GetProperty("turnoId").GetInt32();
                    var inicio = turno.GetProperty("inicio").GetDateTime();
                    var fin = turno.GetProperty("fin").GetDateTime();
                    var estado = turno.GetProperty("estado").GetString() ?? "";
                    <tr>
                        <td>@turno.GetProperty("empleado").GetString()</td>
                        <td>@inicio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@fin.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@estado</td>
                        @if (puedeGestionar)
                        {
                            <td>
                                @if (estado == "PROGRAMADO")
                                {
                                    <details>
                                        <summary>Editar</summary>
                                        <form asp-action="EditarTurno" method="post" class="form-grid" style="min-width:280px;margin-top:10px">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="turnoId" value="@turnoId" />
                                            <div class="form-field">
                                                <label>Inicio</label>
                                                <input type="datetime-local" name="inicio" value="@inicio.ToString("yyyy-MM-ddTHH:mm")" required />
                                            </div>
                                            <div class="form-field">
                                                <label>Fin</label>
                                                <input type="datetime-local" name="fin" value="@fin.ToString("yyyy-MM-ddTHH:mm")" required />
                                            </div>
                                            <button class="btn btn-primary" type="submit">Guardar cambios</button>
                                        </form>
                                    </details>
                                    <form asp-action="CancelarTurno" method="post" style="margin-top:8px">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="turnoId" value="@turnoId" />
                                        <button class="btn btn-secondary" type="submit" onclick="return confirm('¿Deseas cancelar este turno?')">Cancelar</button>
                                    </form>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
