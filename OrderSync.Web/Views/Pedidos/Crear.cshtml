@model OrderSync.Web.ViewModels.CreateOrderViewModel
@{ ViewData["Title"] = "Crear pedido"; }
<div class="page-heading"><div><span class="eyebrow purple">CAJA · NUEVA ORDEN</span><h1>Crear pedido</h1><p class="muted">Selecciona productos activos del menú. Los precios se calculan en el backend.</p></div><a class="btn-secondary" asp-action="Index">← Volver</a></div>
@if (!ViewData.ModelState.IsValid) { <div class="alert alert-error" asp-validation-summary="All"></div> }
<form asp-action="Crear" method="post" class="panel form-panel">
@Html.AntiForgeryToken()
<div class="form-grid"><div class="form-field"><label asp-for="Canal">Canal de venta</label><select asp-for="Canal" id="canal"><option value="MOSTRADOR">Mostrador</option><option value="DOMICILIO">Domicilio</option><option value="QR">QR / Mesa</option></select></div>
<div class="form-field" id="mesa-field"><label asp-for="Mesa">Mesa (para QR)</label><input asp-for="Mesa" placeholder="Ej. 4" /></div>
<div class="form-field" id="direccion-field"><label asp-for="DireccionEntrega">Dirección de entrega</label><input asp-for="DireccionEntrega" placeholder="Dirección del cliente" /></div>
<div class="form-field" id="telefono-field"><label asp-for="TelefonoContacto">Teléfono de contacto</label><input asp-for="TelefonoContacto" placeholder="3001234567" /></div>
<div class="form-field"><label asp-for="ClienteId">ID de cliente (opcional)</label><input asp-for="ClienteId" type="number" min="1" placeholder="Dejar vacío si no aplica" /></div></div>
<hr class="soft-rule"/><div class="table-toolbar"><div><h3>Productos del pedido</h3><p class="muted">Agrega uno o varios productos y sus cantidades.</p></div><button class="btn-secondary" type="button" id="add-line">＋ Agregar producto</button></div>
<div id="order-lines">
@for (var i=0; i<Model.Lineas.Count; i++) { <div class="order-line"><div class="form-field"><label>Producto</label><select name="Lineas[@i].ProductoId" required><option value="">Selecciona un producto</option>@foreach (var p in Model.Productos) { <option value="@p.ProductoId" selected="@(Model.Lineas[i].ProductoId == p.ProductoId ? "selected" : null)">@p.Nombre — @p.Precio.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</option> }</select></div><div class="form-field quantity-field"><label>Cantidad</label><input name="Lineas[@i].Cantidad" type="number" min="1" max="1000" value="@Model.Lineas[i].Cantidad" required /></div><button type="button" class="remove-line btn-small btn-danger">Quitar</button></div> }
</div>
<div class="form-actions"><a class="btn-secondary" asp-action="Index">Cancelar</a><button class="btn-primary" type="submit">Crear pedido en el sistema →</button></div>
</form>
@section Scripts {
<script>
(() => {
 const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Productos.Select(p => new { id=p.ProductoId, name=p.Nombre, price=p.Precio })));
 const host = document.getElementById('order-lines');
 const channel = document.getElementById('canal');
 const toggle = () => { document.getElementById('mesa-field').style.display = channel.value === 'QR' ? '' : 'none'; const home = channel.value === 'DOMICILIO'; document.getElementById('direccion-field').style.display = home ? '' : 'none'; document.getElementById('telefono-field').style.display = home ? '' : 'none'; };
 channel.addEventListener('change', toggle); toggle();
 const options = () => '<option value="">Selecciona un producto</option>' + products.map(p => `<option value="${p.id}">${p.name} — $${Number(p.price).toLocaleString('es-CO')}</option>`).join('');
 const renumber = () => [...host.querySelectorAll('.order-line')].forEach((line,i) => { line.querySelector('select').name=`Lineas[${i}].ProductoId`; line.querySelector('input').name=`Lineas[${i}].Cantidad`; });
 document.getElementById('add-line').addEventListener('click', () => { const div=document.createElement('div'); div.className='order-line'; div.innerHTML=`<div class="form-field"><label>Producto</label><select required>${options()}</select></div><div class="form-field quantity-field"><label>Cantidad</label><input type="number" min="1" max="1000" value="1" required /></div><button type="button" class="remove-line btn-small btn-danger">Quitar</button>`; host.appendChild(div); renumber(); });
 host.addEventListener('click', e => { if(e.target.classList.contains('remove-line')) { if(host.querySelectorAll('.order-line').length>1) e.target.closest('.order-line').remove(); renumber(); } });
})();
</script>
}
